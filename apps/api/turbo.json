{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig*.json", "nest-cli.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "openapi:gen": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["openapi.json"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "DATABASE_POOL_MAX",
        "WORKOS_API_KEY",
        "WORKOS_CLIENT_ID",
        "CORS_ORIGINS",
        "LOG_LEVEL",
        "PORT"
      ]
    }
  }
}
