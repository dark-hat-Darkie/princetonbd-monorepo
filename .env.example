# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Neon exposes two connection strings and they are NOT interchangeable.
#
#   DATABASE_URL           the "-pooler" host (PgBouncer, transaction mode).
#                          Used for every runtime query.
#   DATABASE_URL_UNPOOLED  the direct host. Required by migrations, which use
#                          session-level operations PgBouncer cannot proxy.
#
# Neon example:
#   DATABASE_URL=postgresql://user:pass@ep-cool-rain-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
#   DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-cool-rain-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Local (docker compose up -d) — TLS is derived from the host, so no sslmode needed:
DATABASE_URL=postgresql://princetonbd:princetonbd@localhost:55432/princetonbd
DATABASE_URL_UNPOOLED=postgresql://princetonbd:princetonbd@localhost:55432/princetonbd
DATABASE_POOL_MAX=10

# --- API -------------------------------------------------------------------
PORT=3001
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000
# Comma-separated emails promoted to the admin role on sign-in. Anyone else
# is a student and cannot open /admin or call the admin endpoints.
ADMIN_EMAILS=you@example.com

# --- Object storage (S3-compatible) -----------------------------------------
# Admin uploads (course thumbnails, teacher photos) go straight from the
# browser to a bucket via a presigned URL the API issues. Locally that bucket
# is MinIO (docker compose up -d; console at http://localhost:9001).
#
# Cloudflare R2 example:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_PUBLIC_URL=https://media.example.com        # the bucket's public/custom domain
#   S3_FORCE_PATH_STYLE=false
# AWS S3: leave S3_ENDPOINT empty and set S3_REGION to the bucket's region.
# The bucket needs a CORS rule allowing PUT from the web origin.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=princetonbd-media
S3_ACCESS_KEY_ID=princetonbd
S3_SECRET_ACCESS_KEY=princetonbd-secret
S3_PUBLIC_URL=http://localhost:9000/princetonbd-media
S3_FORCE_PATH_STYLE=true

# --- WorkOS AuthKit --------------------------------------------------------
# From https://dashboard.workos.com  (API Keys, and Redirects for the URI)
WORKOS_API_KEY=sk_test_xxx
WORKOS_CLIENT_ID=client_xxx
# Seals the AuthKit session cookie. Generate with: openssl rand -base64 24
WORKOS_COOKIE_PASSWORD=replace-me-with-at-least-32-characters

# --- Web -------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
# Same value as S3_PUBLIC_URL; the web app allows this host for next/image.
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000/princetonbd-media
