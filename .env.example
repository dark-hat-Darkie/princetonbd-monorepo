# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Neon exposes two connection strings and they are NOT interchangeable.
#
#   DATABASE_URL           the "-pooler" host (PgBouncer, transaction mode).
#                          Used for every runtime query.
#   DATABASE_URL_UNPOOLED  the direct host. Required by migrations, which use
#                          session-level operations PgBouncer cannot proxy.
#
# Neon example:
#   DATABASE_URL=postgresql://user:pass@ep-cool-rain-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
#   DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-cool-rain-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Local (docker compose up -d) — TLS is derived from the host, so no sslmode needed:
DATABASE_URL=postgresql://princetonbd:princetonbd@localhost:55432/princetonbd
DATABASE_URL_UNPOOLED=postgresql://princetonbd:princetonbd@localhost:55432/princetonbd
DATABASE_POOL_MAX=10

# --- API -------------------------------------------------------------------
PORT=3001
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000

# --- WorkOS AuthKit --------------------------------------------------------
# From https://dashboard.workos.com  (API Keys, and Redirects for the URI)
WORKOS_API_KEY=sk_test_xxx
WORKOS_CLIENT_ID=client_xxx
# Seals the AuthKit session cookie. Generate with: openssl rand -base64 24
WORKOS_COOKIE_PASSWORD=replace-me-with-at-least-32-characters

# --- Web -------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
